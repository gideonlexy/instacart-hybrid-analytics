# Local Spark paths used before cloud setup.
RAW_DATA_PATH=data/raw
BRONZE_DATA_PATH=data/bronze
SILVER_DATA_PATH=data/silver
GOLD_DATA_PATH=data/gold

# AWS S3 data lake configuration. Fill these in during the cloud setup step.
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
AWS_REGION=us-east-1
S3_RAW_BUCKET=instacart-raw-yourname
S3_BRONZE_BUCKET=instacart-bronze-yourname
S3_SILVER_BUCKET=instacart-silver-yourname
S3_GOLD_BUCKET=instacart-gold-yourname

# Snowflake warehouse configuration. Keep real values in .env only.
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=analytics_wh
SNOWFLAKE_DATABASE=instacart_analytics
SNOWFLAKE_SCHEMA=staging

# Databricks is optional while we build locally with PySpark first.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your_token
